# Development database supplied by the workspace
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Session signing secret for the future authenticated API boundary.
# Set this through workspace secrets in real environments.
SESSION_SECRET=replace-with-a-long-random-value

# Future service integrations are server-only and should be configured
# through the workspace secrets manager when those phases are enabled.
# AI_PROVIDER=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# OBJECT_STORAGE_BUCKET=