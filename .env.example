# Server-only settings. Copy to .env at the repository root; never commit .env.
# Node 22+ API start/dev scripts load this file automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/database
# To use MongoDB instead, set DATABASE_PROVIDER=mongo and provide MONGODB_URI.
DATABASE_PROVIDER=postgres
MONGODB_URI=
MONGODB_DATABASE=folio

# Frontend origin; development API is proxied through Vite at this address.
# Production must use HTTPS and /api on the same origin as the frontend.
APP_URL=http://localhost:5173
PORT=3001

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# At least 32 characters; the placeholder below intentionally disables sign-in.
SESSION_SECRET=replace-with-a-long-random-value

# Optional social providers. A provider stays unavailable until BOTH values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional legacy administrator; separate from social accounts.
# Admin can access only the pre-existing demo-user portfolios.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=

# Future integrations, not enabled by the current authentication implementation.
# AI_PROVIDER=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# OBJECT_STORAGE_BUCKET=
