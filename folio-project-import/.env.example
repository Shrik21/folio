# Browser and server Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini is the simplest recommended AI setup. Keep this key server-side.
GEMINI_API_KEY=

# Optional generic OpenAI-compatible provider. Gemini takes priority when both keys exist.
# When both keys are omitted, Folio uses its grounded local parser.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Bootstrap defaults match the requested administrator account.
# Change these after the first production login.
ADMIN_EMAIL=admin@folio.com
ADMIN_PASSWORD=Admin@123

# Public canonical URL
SITE_URL=http://localhost:3000
